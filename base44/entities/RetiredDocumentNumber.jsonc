{
  "name": "RetiredDocumentNumber",
  "type": "object",
  "properties": {
    "doc_type": {
      "type": "string",
      "enum": [
        "quote",
        "invoice"
      ],
      "description": "Type of document the retired number belongs to"
    },
    "number": {
      "type": "string",
      "description": "The retired document number that can no longer be reused"
    },
    "year": {
      "type": "number",
      "description": "Year segment of the number, used for faster filtering"
    },
    "prefix": {
      "type": "string",
      "description": "Prefix segment of the number (e.g. Q, QD, INV, ID)"
    },
    "doc_id": {
      "type": "string",
      "description": "Original document ID that held this number"
    },
    "reason": {
      "type": "string",
      "description": "Why the number was retired (e.g. document deleted)"
    }
  },
  "required": [
    "doc_type",
    "number"
  ]
}