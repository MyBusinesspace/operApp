{
  "name": "ProjectNote",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "note": {
      "type": "string",
      "description": "Note content"
    },
    "action": {
      "type": "string",
      "enum": [
        "Note",
        "Call",
        "Email",
        "Meeting",
        "Update"
      ],
      "default": "Note"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user who added the note"
    }
  },
  "required": [
    "project_id",
    "note"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}