{
  "name": "AssetField",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Field label shown in the asset form"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number"
      ],
      "default": "text",
      "description": "Whether the field value is free text or numeric"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the asset form (lower numbers appear first)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive fields are hidden from the asset form but existing values are kept"
    }
  },
  "required": [
    "name",
    "field_type"
  ]
}