{
  "name": "TaskSubtask",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Reference to Task"
    },
    "title": {
      "type": "string",
      "description": "Subtask instruction"
    },
    "done": {
      "type": "boolean",
      "default": false,
      "description": "Completed?"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual display order (lower = higher on the list)"
    }
  },
  "required": [
    "task_id",
    "title"
  ]
}