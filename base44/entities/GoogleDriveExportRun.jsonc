{
  "name": "GoogleDriveExportRun",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running",
      "description": "Current status of the export run"
    },
    "has_more": {
      "type": "boolean",
      "default": false,
      "description": "True while the session has more batches to process (drives the chaining workflow)"
    },
    "current_stage": {
      "type": "string",
      "default": "init",
      "description": "Current export stage (init, organization, business_companies, business_projects, business_assets, done)"
    },
    "current_offset": {
      "type": "number",
      "default": 0,
      "description": "Current batch offset within the stage"
    },
    "current_item": {
      "type": "string",
      "description": "Current item being processed (for UI feedback)"
    },
    "files_uploaded": {
      "type": "number",
      "default": 0
    },
    "files_skipped": {
      "type": "number",
      "default": 0
    },
    "error": {
      "type": "string",
      "description": "Error message if status is failed"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}