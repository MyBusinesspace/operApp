{
  "name": "PettyCashEntry",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ],
      "default": "expense",
      "description": "Whether this is an expense or income entry"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee"
    },
    "employee_name": {
      "type": "string",
      "description": "Cached employee name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the entry"
    },
    "provider": {
      "type": "string",
      "description": "Supplier / provider name"
    },
    "note_number": {
      "type": "string",
      "description": "Receipt or note reference number"
    },
    "note": {
      "type": "string",
      "description": "Description / note"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Amount paid (expense) or received (income)"
    },
    "currency": {
      "type": "string",
      "default": "AED"
    },
    "category": {
      "type": "string",
      "description": "Expense category (fuel, food, materials, etc.)"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "work_order_name": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt / photo URL"
    },
    "ai_extracted": {
      "type": "boolean",
      "default": false,
      "description": "Was this entry extracted via AI from a receipt photo?"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "employee_id",
    "date",
    "amount",
    "type"
  ]
}