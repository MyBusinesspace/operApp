{
  "name": "AttendanceDay",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Reference to the Employee"
    },
    "employee_name": {
      "type": "string",
      "description": "Cached employee name"
    },
    "user_id": {
      "type": "string",
      "description": "The id of the app user who owns this attendance day (Employee.user_id of the person, when it exists)."
    },
    "work_date": {
      "type": "string",
      "description": "Company-local calendar date of the clock-in (YYYY-MM-DD, Asia/Dubai)"
    },
    "clock_in_time": {
      "type": "string",
      "description": "ISO datetime the session started"
    },
    "clock_out_time": {
      "type": "string",
      "description": "ISO datetime the session ended"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total session length in minutes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed",
        "AutoClosed"
      ],
      "default": "Open",
      "description": "Current state of the attendance day"
    },
    "closed_by": {
      "type": "string",
      "enum": [
        "self",
        "auto",
        "manager"
      ],
      "description": "Who closed the session"
    },
    "alert_sent_at": {
      "type": "string",
      "description": "When the last inactivity reminder was sent"
    },
    "confirmed_at": {
      "type": "string",
      "description": "When the worker confirmed they are still on shift"
    },
    "next_alert_at": {
      "type": "string",
      "description": "When the next inactivity reminder is due"
    },
    "currency": {
      "type": "string",
      "default": "AED",
      "description": "Currency stamped at clock-in from PayrollSettings.currency"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "employee_id",
    "work_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_time": true
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_time": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_time": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_time": true
          }
        }
      ]
    }
  }
}