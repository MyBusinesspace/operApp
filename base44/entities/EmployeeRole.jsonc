{
  "name": "EmployeeRole",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Role display name"
    },
    "key": {
      "type": "string",
      "description": "Unique machine-friendly key e.g. field_staff"
    },
    "color": {
      "type": "string",
      "default": "#6366f1",
      "description": "Hex color for the role badge"
    },
    "icon": {
      "type": "string",
      "default": "Shield",
      "description": "lucide-react icon name for the role"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "System roles cannot be deleted"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual column order in the permissions matrix (lower = further left)"
    },
    "can_view_all_employees": {
      "type": "boolean",
      "default": false,
      "description": "When true, all users with this role can view & edit ALL employee profiles AND their HR documents (not just their own). Administrator role is always true."
    },
    "can_view_all_leave": {
      "type": "boolean",
      "default": false,
      "description": "When true, all users with this role can view & edit ALL employees' leave requests (not just their own). Administrator role is always true."
    },
    "can_view_all_payroll": {
      "type": "boolean",
      "default": false,
      "description": "When true, all users with this role can view & edit ALL employees' payroll entries (not just their own). Administrator role is always true."
    },
    "can_view_all_petty_cash": {
      "type": "boolean",
      "default": false,
      "description": "When true, all users with this role can view & edit ALL employees' petty cash entries (not just their own). Administrator role is always true."
    },
    "can_edit_all_employees": {
      "type": "boolean",
      "description": "Data-scope level for Profiles & HR documents: true = view & edit everyone's; false with can_view_all_employees true = view only. Absent on legacy roles means full edit."
    },
    "can_edit_all_leave": {
      "type": "boolean",
      "description": "Data-scope level for Leave: true = view & edit everyone's; false with can_view_all_leave true = view only. Absent on legacy roles means full edit."
    },
    "can_edit_all_payroll": {
      "type": "boolean",
      "description": "Data-scope level for Payroll: true = view & edit everyone's; false with can_view_all_payroll true = view only. Absent on legacy roles means full edit."
    },
    "can_edit_all_petty_cash": {
      "type": "boolean",
      "description": "Data-scope level for Petty cash: true = view & edit everyone's; false with can_view_all_petty_cash true = view only. Absent on legacy roles means full edit."
    }
  },
  "required": [
    "name",
    "key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}