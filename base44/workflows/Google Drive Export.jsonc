{
  "name": "Google Drive Export",
  "description": "Runs the full Google Drive export in the background, triggered when an export run is created",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GoogleDriveExportRun",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"running\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_drive_export",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "batch_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportToGoogleDrive",
            "args": {
              "stage": "next_batch",
              "run_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check_1",
          "x-base44": {
            "title": "Batch 1"
          }
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .batch_1.hasMore == true }",
              "then": "batch_2"
            },
            {
              "when": "${ true }",
              "then": "finish"
            }
          ],
          "x-base44": {
            "title": "Check 1"
          }
        }
      },
      {
        "batch_2": {
          "call": "invoke_backend_function",
