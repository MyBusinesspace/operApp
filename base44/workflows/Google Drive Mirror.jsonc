{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_drive_mirror",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "start": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportToGoogleDrive",
            "args": {
              "mode": "start_incremental"
            }
          },
          "then": "check_start",
          "x-base44": {
            "title": "Open sync session",
            "description": "Resumes an unfinished session"
          }
        }
      },
      {
        "check_start": {
          "switch": [
            {
              "when": "${ .start.hasMore == true }",
              "then": "batch_1"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Session ready?"
          }
        }
      },
      {
        "batch_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportToGoogleDrive",
            "args": {
              "mode": "next_batch",
              "run_id": "${ .start.run_id }"
            }
          },
          "then": "check_1",
          "x-base44": {
            "title": "Batch 1"
          }
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .batch_1.hasMore == true }",
