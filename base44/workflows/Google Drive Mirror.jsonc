  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Dubai",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Google Drive Mirror",
  "description": "Hourly incremental mirror of app files into Google Drive. Resumes the unfinished session if there is one, otherwise syncs everything created or changed since the last completed run, then mirrors deletions."
}