#!/bin/sh
# Strip editor co-author trailers and block remaining editor branding in messages.
msg_file="$1"
if [ ! -f "$msg_file" ]; then
  exit 0
fi

# Cursor (and similar) may auto-append co-author lines — remove them silently.
tmp="${msg_file}.stripped"
# Build patterns without storing the full banned email in one literal where avoidable.
grep -viE \
  "Co-authored-by:[[:space:]]*Cursor|cursoragent@|Made with Cursor|powered by Cursor|Generated by Cursor" \
  "$msg_file" > "$tmp" 2>/dev/null || true

# If grep matched nothing and wrote empty because every line matched, keep subject:
if [ ! -s "$tmp" ]; then
  # Keep first non-empty line of original as subject fallback
  sed -n '1,/^$/p' "$msg_file" | grep -viE "Co-authored-by:[[:space:]]*Cursor|cursoragent@" > "$tmp" || true
fi

mv "$tmp" "$msg_file"

# After stripping trailers, still reject explicit branding left in the subject/body.
if grep -nEi \
  'Made with Cursor|powered by Cursor|Generated by Cursor|https?://cursor\.(com|sh)' \
  "$msg_file" >/dev/null 2>&1
then
  echo ""
  echo "Commit blocked: message must not include editor branding links/phrases."
  echo ""
  exit 1
fi

exit 0
