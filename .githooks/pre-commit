#!/bin/sh
# Block staging IDE editor files or editor-branding markers inside staged diffs.

blocked_paths=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.cursor(/|$)|^\.cursorrules$' || true)
if [ -n "$blocked_paths" ]; then
  echo ""
  echo "Commit blocked: local IDE config paths are not allowed in git:"
  echo "$blocked_paths"
  echo "Unstage them (they should stay local / gitignored)."
  echo ""
  exit 1
fi

# Patterns assembled so this hook file does not contain the banned literals itself.
p1='cursoragent@'
p2='cursor\.com'
p3='Co-authored-by:[[:space:]]*Cursor'
p4='Made with Cursor'
p5='powered by Cursor'
p6='Generated by Cursor'
p7='https?://cursor\.(com|sh)'
pattern="${p1}${p2}|${p3}|${p4}|${p5}|${p6}|${p7}"

# Do not scan the hooks themselves (they document / encode the bans).
if git diff --cached -U0 -- . ':(exclude).githooks/*' ':(exclude)scripts/install-git-hooks.mjs' \
  | grep -nEi "$pattern" >/dev/null 2>&1
then
  echo ""
  echo "Commit blocked: staged changes contain editor co-author / branding markers."
  echo "Remove those strings before committing."
  echo ""
  exit 1
fi

exit 0
