# =============================================================================
# Vercel Environment Variables — import this file in Vercel
# =============================================================================
# How to import:
#   1. Fill in the values below (Supabase cloud project + your Vercel URL)
#   2. Vercel Dashboard → Project → Settings → Environment Variables
#   3. Use "Import .env" / paste contents, OR:
#        npx vercel env pull   (after linking)
#      For bulk add from this file via CLI (interactive):
#        Get-Content vercel.env | ForEach-Object { ... }
#
# Apply to: Production, Preview, Development (recommended for all Vite keys)
# =============================================================================

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Storage bucket created by supabase/migrations/00001_init.sql
VITE_SUPABASE_STORAGE_BUCKET=uploads

# App label used by auth.me() mapping (not Base44 cloud)
VITE_BASE44_APP_ID=operapp

# Public site URL (OAuth redirect target). After first deploy, set to your real domain:
#   https://operapp.vercel.app   OR   https://your-custom-domain.com
VITE_APP_URL=https://YOUR_PROJECT.vercel.app
