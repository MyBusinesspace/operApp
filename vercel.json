{
  "functions": {
    "api/*.js": {
      "includeFiles": "packages/base44-server/generated/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:rest*",
      "destination": "/api/index?__path=:rest*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
